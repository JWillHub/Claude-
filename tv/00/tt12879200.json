{"id":"tt12879200","title":"The Unfaithful","year":"2020","end":"2022","r":6.4,"v":3102,"s":{"1":[[1,7.2,101,"Ben bir kurban olmayacagim!"],[2,7.0,75,"Her yânim kabus..."],[3,6.7,66,"Yapmam dedigim ne varsa..."],[4,6.7,62,"Domino taslari gibi..."],[5,6.5,59,"Kalbi camdan Asya..."],[6,6.5,67,"Zifiri karanlikta savas..."],[7,6.5,56,"Aski öldüren son nefes..."],[8,6.3,57,"Aile dedigin, açik bir yara..."],[9,6.1,55,"Kaybettiklerinle göz göze..."],[10,6.1,52,"Sahte beyaz güller..."],[11,6.3,48,"Yalnizliktan çogalan güç..."],[12,6.0,52,"Aydinlik geçmisin karanlik bugünü..."],[13,6.3,48,"Vadesi dolmamis duygular..."],[14,6.1,50,"Zincirleme Kazalar"],[15,6.1,45,"Pandora'nin Kutusu"],[16,6.0,44,"Sonsuz Ayrilik"],[17,5.8,47,"Anahtarin Kalbi"],[18,6.1,42,"Geçmisin Intikami"],[19,5.9,44,"Dünden Kalanlarin Girdabi"],[20,5.8,41,"Yüz Yas Yaslanmak"],[21,6.1,41,"Koruyucu Melek"],[22,5.4,41,"Yerin Dibindeki Yüzlesme"],[23,5.6,38,"Geçmisin yansimasi"],[24,5.5,39,"Dizginlenemeyen kelimeler..."],[25,6.1,40,"Bazi yanlislar dogrudur."],[26,5.8,36,"Nüks eden kirginliklar..."],[27,5.5,33,"Kalbi Kahraman Kadin..."],[28,6.3,30,"Ihanetle sIrdas, ask..."],[29,5.7,36,"Nokta konmus cümleler..."],[30,6.0,36,"Tehlikeli sevgiler..."],[31,6.2,35,"Önüm arkam sagim solum, uçurum..."]],"2":[[1,7.3,31,"Sehre dönen yabanci..."],[2,6.7,24,"Mahkum olunan uyanis..."],[3,6.9,22,"Sifir noktasi..."],[4,6.9,21,"Sahip çikilan..."],[5,6.9,22,"Bilinmezligin içinde yeseren hisler..."],[6,7.2,21,"Sadakati sinayan güven..."],[7,6.9,21,"Madalyonun iki farkli yüzü..."],[8,6.9,21,"Bambaska bir zamanda, yine..."],[9,6.8,21,"Susturulan kalbin çigligi..."],[10,6.6,21,"Geri sayima düsen, kalp..."],[11,7.1,22,"Kusun kanadindaki agirlik..."],[12,6.9,20,"Kararsizlikta örülü dügümler..."],[13,6.7,20,"Episode #2.13"],[14,6.6,22,"Yeni bir baslangiç sizisi..."],[15,6.9,20,"Asya'nin fotografi..."],[16,6.5,19,"Sarpa saran yalanlar..."],[17,6.4,18,"Geçmisten gelen..."],[18,6.9,18,"Yeniden dagitilan kartlar..."],[19,6.3,16,"Asilmasi güç yollar..."],[20,6.8,18,"Sonun baslangici..."],[21,6.5,18,"Kusanilan savas baltalari..."],[22,7.9,23,"Ansizin degisen roller..."],[23,6.9,16,"Her seyin basladigi yer..."],[24,6.9,19,"Dogruya ilerleyen yanlislar..."],[25,6.9,18,"Kalbe saplanan ok!"],[26,6.6,17,"Sikisip kalinan o sarmal..."],[27,7.9,21,"Kalpte açilan kesik..."],[28,7.2,18,"Geç kalinmis uyanis..."],[29,6.4,26,"O romanin son cümlesi."]]}}