{"id":"tt0292765","title":"Gokusen","year":"2002","end":"2008","r":7.4,"v":2256,"s":{"1":[[1,8.7,75,"Nekketsu sensei Ô abare!!"],[2,8.1,38,"Tomodachi mi suten na yo!!"],[3,8.3,34,"Mita me de kimen na!!"],[4,8.3,32,"Shippai shita ra yarinaose"],[5,8.2,30,"Kenka to bôryoku wa chigau"],[6,7.9,28,"Ijime ni maken na!!"],[7,8.2,26,"Jibun no ko wo shinjiro!!"],[8,8.1,25,"Anta wa haha oya daro!!"],[9,7.6,23,"Hito no sei ni sun na!!"],[10,8.1,22,"Watashi wa seito wo shinjiru!!"],[11,8.0,22,"Omaera hitori ja nai"],[12,8.5,30,"Sayonara yankumi"]],"2":[[1,7.5,17,"Episode #2.1"],[2,7.5,14,"Episode #2.2"],[3,7.5,14,"Episode #2.3"],[4,8.4,14,"Episode #2.4"],[5,8.0,14,"Episode #2.5"],[6,8.1,13,"Episode #2.6"],[7,8.0,12,"Episode #2.7"],[8,8.2,12,"Episode #2.8"],[9,8.2,12,"Episode #2.9"],[10,8.2,14,"Episode #2.10"]],"3":[[1,8.5,15,"Ano Yankumi ga kaettekita densetsu no gakuen dorama tsuini fukkatsu!"],[2,8.1,13,"Omaera wa kyô kara nakamada! !"],[3,7.9,11,"Itsu datte yarinaoseru! !"],[4,8.3,12,"Ane to otôto namida no kizuna! !"],[5,8.2,12,"Hitori de ikite kita to omou na"],[6,8.5,12,"Hatsukoi... taisetsunahito o mamori nuke"],[7,8.1,12,"Jibun ni ii wake sun na! !"],[8,8.5,12,"Tsuyokunare! ! Atarashii inochi no tanjô"],[9,7.9,11,"Nakama wa isshô mon no takarada! !"],[10,7.9,12,"Shiawase wa jibun no te de tsukame! !"],[11,8.3,15,"Yankumi saigo no namida no sakebi... inochiwotaisetsuni shiro! !"]]}}