{"id":"tt15975122","title":"Call of the Night","year":"2022","end":"2025","r":7.6,"v":8625,"s":{"1":[[1,7.7,912,"Naito furaito"],[2,7.7,787,"Teka Rain yatteru?"],[3,8.0,757,"Ippai deta ne"],[4,7.8,739,"Semakunai?"],[5,7.6,715,"Sorya komatta yatsu desu ne"],[6,7.7,710,"Tanoshii hôgai yo"],[7,8.3,753,"Kozukuri"],[8,7.5,665,"Doitsumo koitsumo"],[9,8.0,685,"Zurui"],[10,7.3,667,"Totogazô o kakudai shite miru"],[11,8.4,763,"Kyûketsuki tte shitterukai?"],[12,8.1,676,"Kyôuchi oya inai nda"],[13,8.4,771,"Yofukashi no uta"]],"2":[[1,7.8,668,"Sore wa bokura no jikan janai"],[2,8.0,631,"Aitakatta yo"],[3,8.5,624,"Obake yashiki ni wa obakeinai"],[4,9.0,795,"Hashireru yô ni naritai kai?"],[5,8.8,663,"Anata to sugoshita sûnenkan"],[6,7.5,550,"Kuoritî o kiiterun janê yo"],[7,8.3,582,"Nanakusa-san baka dakara"],[8,9.3,869,"Senpai ga hajimetessu yo"],[9,8.9,665,"Yamori-kun, kimi wa dô shitai?"],[10,9.3,742,"Semete omae ni"],[11,8.6,509,"Nchu"],[12,8.5,545,"Call of the Night"]]}}