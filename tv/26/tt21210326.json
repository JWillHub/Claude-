{"id":"tt21210326","title":"Tomo-chan Is a Girl!","year":"2023","end":"2023","r":7.5,"v":6192,"s":{"1":[[1,7.2,344,"On'nanoko ni miraretai!/Senritsu no chôsenjô"],[2,7.3,312,"Tomo no sukâto/Gakuen no aidoru"],[3,7.4,295,"Shinyû no himitsu/Dêto shiyô ze!"],[4,7.5,288,"Egao no riyû/Joshippoku tawamuretai/Hîrô wa yoku korobu"],[5,7.7,291,"Ôrusuton-ke no on'na-tachi/Yuzurenai omoi/Dokidoki! Gêmu gasshuku"],[6,7.7,274,"Bâsudê purezento/Moero! Kyûgi taikai"],[7,7.8,272,"Junichirô no chikai/Tomo ga mizugi ni kigaetara"],[8,7.6,260,"Natsumatsuri no yoru/Futari no kyorikan"],[9,7.7,254,"Tenshi no sugao"],[10,7.5,246,"Shôbu no yukue/Shinyû de iru tame ni......"],[11,7.4,248,"Hajimete no arubaito/Oitekebori no Shinderera"],[12,8.3,302,"Sayonara, shinyû"],[13,8.3,329,"Tonari ni iru tame ni..."]]}}