{"id":"tt21210326","title":"Tomo-chan Is a Girl!","year":"2023","end":"2023","r":7.5,"v":6170,"s":{"1":[[1,7.2,342,"On'nanoko ni miraretai!/Senritsu no chôsenjô"],[2,7.3,310,"Tomo no sukâto/Gakuen no aidoru"],[3,7.4,293,"Shinyû no himitsu/Dêto shiyô ze!"],[4,7.5,286,"Egao no riyû/Joshippoku tawamuretai/Hîrô wa yoku korobu"],[5,7.7,289,"Ôrusuton-ke no on'na-tachi/Yuzurenai omoi/Dokidoki! Gêmu gasshuku"],[6,7.7,271,"Bâsudê purezento/Moero! Kyûgi taikai"],[7,7.8,269,"Junichirô no chikai/Tomo ga mizugi ni kigaetara"],[8,7.6,257,"Natsumatsuri no yoru/Futari no kyorikan"],[9,7.7,252,"Tenshi no sugao"],[10,7.5,244,"Shôbu no yukue/Shinyû de iru tame ni......"],[11,7.4,246,"Hajimete no arubaito/Oitekebori no Shinderera"],[12,8.3,299,"Sayonara, shinyû"],[13,8.3,326,"Tonari ni iru tame ni..."]]}}