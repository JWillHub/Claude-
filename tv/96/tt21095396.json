{"id":"tt21095396","title":"The Hammer and the Rose: A Behzat Ç. Story","year":"2022","end":"","r":8.4,"v":3961,"s":{"1":[[1,8.5,312,"Ve karanlik büyüyor..."],[2,8.6,259,"Iyi de paket ne is?"],[3,8.6,229,"Yalniz olan biz degiliz bu sehir..."],[4,8.5,218,"Tesadüflere inanir misiniz?"],[5,8.4,192,"Büyük bir kötülük yaptim ben."],[6,8.5,199,"Ceset gömen adama iyi adam denir mi?"],[7,8.7,235,"Bir felaket oldu..."],[8,7.3,255,"Her sey Gaspi'nin ölümüyle basladi..."]],"2":[[1,7.6,155,"Insanin Dirisi Çigdir, Ölüsü Bayat"],[2,7.8,118,"Sen De Bizdensin"],[3,7.6,115,"Çok Mutsuzum Lan!"],[4,7.9,112,"Sigamiyorsun Degil Mi Bu Sehre?"],[5,7.4,118,"Toksik Iliski"],[6,8.0,117,"Mesele Adalet"],[7,8.4,131,"Adi Boncuk Olacak"]],"3":[[1,7.1,197,"Kurdun Adi Cikmis Cakal Vardir Bas Keser"],[2,6.3,188,"Her Sey Yeniden Basliyor"],[3,4.8,225,"Dünyaya Hic Gelmemis Olmak"],[4,5.2,155,"Büyük Kavga Basladi"],[5,4.8,140,"Hekimin Hükmü"],[6,5.6,148,"Hayalet Sevgili"],[7,3.9,185,"Sevincin Tedavisi Aciyla Olur"]],"4":[[1,8.0,61,"Süper Baba"],[2,8.4,67,"Ç. Ne Demek?"],[3,8.1,53,"Kundurasiz Sabri"],[4,7.8,50,"Melamet Hirkasi"],[5,8.1,51,"112 Gelmeyecek"],[6,8.3,57,"Mesele"],[7,8.3,52,"Devlet Terbiyesi"],[8,8.5,63,"Karganin Gözü"]]}}