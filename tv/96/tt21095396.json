{"id":"tt21095396","title":"The Hammer and the Rose: A Behzat Ç. Story","year":"2022","end":"","r":8.4,"v":3948,"s":{"1":[[1,8.5,310,"Ve karanlik büyüyor..."],[2,8.6,257,"Iyi de paket ne is?"],[3,8.6,227,"Yalniz olan biz degiliz bu sehir..."],[4,8.5,216,"Tesadüflere inanir misiniz?"],[5,8.3,190,"Büyük bir kötülük yaptim ben."],[6,8.5,197,"Ceset gömen adama iyi adam denir mi?"],[7,8.7,233,"Bir felaket oldu..."],[8,7.3,253,"Her sey Gaspi'nin ölümüyle basladi..."]],"2":[[1,7.6,153,"Insanin Dirisi Çigdir, Ölüsü Bayat"],[2,7.8,116,"Sen De Bizdensin"],[3,7.6,113,"Çok Mutsuzum Lan!"],[4,7.9,110,"Sigamiyorsun Degil Mi Bu Sehre?"],[5,7.4,116,"Toksik Iliski"],[6,8.0,115,"Mesele Adalet"],[7,8.4,129,"Adi Boncuk Olacak"]],"3":[[1,7.1,195,"Kurdun Adi Cikmis Cakal Vardir Bas Keser"],[2,6.3,186,"Her Sey Yeniden Basliyor"],[3,4.8,223,"Dünyaya Hic Gelmemis Olmak"],[4,5.1,153,"Büyük Kavga Basladi"],[5,4.7,138,"Hekimin Hükmü"],[6,5.5,145,"Hayalet Sevgili"],[7,3.9,183,"Sevincin Tedavisi Aciyla Olur"]],"4":[[1,7.7,49,"Süper Baba"],[2,8.2,55,"Ç. Ne Demek?"],[3,7.8,42,"Kundurasiz Sabri"],[4,7.7,40,"Melamet Hirkasi"],[5,7.8,40,"112 Gelmeyecek"],[6,8.1,43,"Mesele"],[7,8.1,41,"Devlet Terbiyesi"],[8,8.3,49,"Karganin Gözü"]]}}