{"id":"tt21095396","title":"The Hammer and the Rose: A Behzat Ç. Story","year":"2022","end":"","r":8.4,"v":3985,"s":{"1":[[1,8.5,316,"Ve karanlik büyüyor..."],[2,8.6,261,"Iyi de paket ne is?"],[3,8.6,231,"Yalniz olan biz degiliz bu sehir..."],[4,8.5,220,"Tesadüflere inanir misiniz?"],[5,8.4,194,"Büyük bir kötülük yaptim ben."],[6,8.5,201,"Ceset gömen adama iyi adam denir mi?"],[7,8.7,238,"Bir felaket oldu..."],[8,7.3,256,"Her sey Gaspi'nin ölümüyle basladi..."]],"2":[[1,7.6,157,"Insanin Dirisi Çigdir, Ölüsü Bayat"],[2,7.8,119,"Sen De Bizdensin"],[3,7.6,116,"Çok Mutsuzum Lan!"],[4,7.9,113,"Sigamiyorsun Degil Mi Bu Sehre?"],[5,7.4,119,"Toksik Iliski"],[6,8.0,118,"Mesele Adalet"],[7,8.4,132,"Adi Boncuk Olacak"]],"3":[[1,7.1,200,"Kurdun Adi Cikmis Cakal Vardir Bas Keser"],[2,6.3,191,"Her Sey Yeniden Basliyor"],[3,4.9,229,"Dünyaya Hic Gelmemis Olmak"],[4,5.2,158,"Büyük Kavga Basladi"],[5,4.8,143,"Hekimin Hükmü"],[6,5.6,152,"Hayalet Sevgili"],[7,3.9,190,"Sevincin Tedavisi Aciyla Olur"]],"4":[[1,8.0,77,"Süper Baba"],[2,8.3,85,"Ç. Ne Demek?"],[3,8.1,65,"Kundurasiz Sabri"],[4,7.7,64,"Melamet Hirkasi"],[5,8.0,63,"112 Gelmeyecek"],[6,8.3,68,"Mesele"],[7,8.3,64,"Devlet Terbiyesi"],[8,8.5,77,"Karganin Gözü"]]}}