{"id":"tt21095396","title":"The Hammer and the Rose: A Behzat Ç. Story","year":"2022","end":"","r":8.4,"v":3972,"s":{"1":[[1,8.5,314,"Ve karanlik büyüyor..."],[2,8.6,260,"Iyi de paket ne is?"],[3,8.6,230,"Yalniz olan biz degiliz bu sehir..."],[4,8.5,219,"Tesadüflere inanir misiniz?"],[5,8.4,193,"Büyük bir kötülük yaptim ben."],[6,8.5,200,"Ceset gömen adama iyi adam denir mi?"],[7,8.7,237,"Bir felaket oldu..."],[8,7.3,256,"Her sey Gaspi'nin ölümüyle basladi..."]],"2":[[1,7.6,156,"Insanin Dirisi Çigdir, Ölüsü Bayat"],[2,7.8,119,"Sen De Bizdensin"],[3,7.6,116,"Çok Mutsuzum Lan!"],[4,7.9,113,"Sigamiyorsun Degil Mi Bu Sehre?"],[5,7.4,119,"Toksik Iliski"],[6,8.0,118,"Mesele Adalet"],[7,8.4,132,"Adi Boncuk Olacak"]],"3":[[1,7.1,199,"Kurdun Adi Cikmis Cakal Vardir Bas Keser"],[2,6.3,190,"Her Sey Yeniden Basliyor"],[3,4.9,228,"Dünyaya Hic Gelmemis Olmak"],[4,5.2,157,"Büyük Kavga Basladi"],[5,4.8,142,"Hekimin Hükmü"],[6,5.6,151,"Hayalet Sevgili"],[7,3.9,188,"Sevincin Tedavisi Aciyla Olur"]],"4":[[1,8.0,69,"Süper Baba"],[2,8.3,76,"Ç. Ne Demek?"],[3,8.1,60,"Kundurasiz Sabri"],[4,7.7,59,"Melamet Hirkasi"],[5,8.0,58,"112 Gelmeyecek"],[6,8.3,63,"Mesele"],[7,8.3,58,"Devlet Terbiyesi"],[8,8.5,70,"Karganin Gözü"]]}}