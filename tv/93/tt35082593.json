{"id":"tt35082593","title":"Gassal","year":"2024","end":"2026","r":8.1,"v":8437,"s":{"1":[[1,8.0,649,"Ben, Gassal"],[2,8.1,565,"Kim Olecek, Kim Kalacak Nazim?"],[3,7.8,551,"Helvalar ve Sirlari"],[4,7.5,509,"Ölünün Manzaraya Ihtiyaci Olmaz"],[5,8.6,535,"Merak Ettim... Neden Evlenmezmissin Benimle?"],[6,8.4,494,"Servis, Cüzdan, Ask ve Ölüm"],[7,8.5,506,"Kimsenin Istemedigi Bir Adam"],[8,8.1,485,"Herkes Gitti, Ben Kaldim"],[9,8.6,498,"Hiç Bilmeseydim Özgürdüm..."],[10,9.3,828,"Sen, Ben ve Çocuklar"]],"2":[[1,7.3,192,"9 Ay Beklememis Bir Baba"],[2,7.1,168,"Gül Suyu ve Zemzemin Muhtesem Aromasi"],[3,7.4,178,"Söyle Görkemli Bir Cenaze"],[4,7.1,157,"Burçlarin En Güzeli"],[5,7.4,162,"Ölen Anneanneler, Öldüren Anneanneler"],[6,7.8,167,"Benim Adim Neden Baki?"],[7,7.2,156,"Asktan Baska Sebepler"],[8,6.9,157,"Güler Yüzün Yakismadigi Meslek"],[9,7.3,155,"Tenesirde Ölenler, Tenesirde Doganlar"],[10,7.7,196,"Çirkin Degiliz... Hiçbirimiz"]],"3":[[1,6.9,97,"Sosyal perdeler ve sümüklü böcek yalnizligi"],[2,7.4,80,"Menemenler ve sofralar"],[3,7.3,80,"Pratik islere yer yok"],[4,7.3,77,"Gassal olunmaz, dogulur"],[5,7.8,78,"Bana ölümden bahset, bir de aglamaktan"],[6,7.4,75,"Tek bir tas"],[7,7.3,73,"Insan dedigin, çocuklugu kadar"],[8,7.2,75,"Bir anne neden ölür?"],[9,7.1,74,"Son aksam yemegi"],[10,5.3,133,"Ölüm, dilime dolanan bir sarki gibi..."]],"4":[[1,6.6,31,"Episode #4.1"],[2,7.2,13,"Episode #4.2"],[3,7.8,15,"Episode #4.3"],[4,7.3,13,"Episode #4.4"],[5,7.1,12,"Episode #4.5"],[6,7.5,12,"Episode #4.6"],[7,7.5,11,"Episode #4.7"],[8,8.7,13,"Episode #4.8"],[9,8.3,10,"Episode #4.9"],[10,8.5,11,"Episode #4.10"]]}}