{"id":"tt35082593","title":"Gassal","year":"2024","end":"","r":8.1,"v":8384,"s":{"1":[[1,8.0,637,"Ben, Gassal"],[2,8.1,562,"Kim Olecek, Kim Kalacak Nazim?"],[3,7.8,549,"Helvalar ve Sirlari"],[4,7.5,508,"Ölünün Manzaraya Ihtiyaci Olmaz"],[5,8.6,534,"Merak Ettim... Neden Evlenmezmissin Benimle?"],[6,8.4,493,"Servis, Cüzdan, Ask ve Ölüm"],[7,8.5,504,"Kimsenin Istemedigi Bir Adam"],[8,8.1,484,"Herkes Gitti, Ben Kaldim"],[9,8.6,497,"Hiç Bilmeseydim Özgürdüm..."],[10,9.3,823,"Sen, Ben ve Çocuklar"]],"2":[[1,7.3,187,"9 Ay Beklememis Bir Baba"],[2,7.1,167,"Gül Suyu ve Zemzemin Muhtesem Aromasi"],[3,7.4,177,"Söyle Görkemli Bir Cenaze"],[4,7.1,156,"Burçlarin En Güzeli"],[5,7.4,161,"Ölen Anneanneler, Öldüren Anneanneler"],[6,7.8,166,"Benim Adim Neden Baki?"],[7,7.2,155,"Asktan Baska Sebepler"],[8,6.9,156,"Güler Yüzün Yakismadigi Meslek"],[9,7.3,154,"Tenesirde Ölenler, Tenesirde Doganlar"],[10,7.7,195,"Çirkin Degiliz... Hiçbirimiz"]],"3":[[1,6.9,88,"Sosyal perdeler ve sümüklü böcek yalnizligi"],[2,7.4,77,"Menemenler ve sofralar"],[3,7.4,77,"Pratik islere yer yok"],[4,7.4,74,"Gassal olunmaz, dogulur"],[5,7.9,74,"Bana ölümden bahset, bir de aglamaktan"],[6,7.4,71,"Tek bir tas"],[7,7.4,70,"Insan dedigin, çocuklugu kadar"],[8,7.2,72,"Bir anne neden ölür?"],[9,7.1,71,"Son aksam yemegi"],[10,5.2,125,"Ölüm, dilime dolanan bir sarki gibi..."]],"4":[[1,null,0,"Episode #4.1"]]}}