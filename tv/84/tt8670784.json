{"id":"tt8670784","title":"Angels of Death","year":"2018","end":"2018","r":6.5,"v":4219,"s":{"1":[[1,7.2,159,"Kill me... please."],[2,7.0,126,"Your grave is not here."],[3,7.2,120,"I swear to God."],[4,7.4,124,"A sinner has no right of choice."],[5,7.4,118,"Don't let me kill you just yet."],[6,7.7,119,"Zack is the only one who can kill me."],[7,7.6,105,"Who are you?"],[8,7.9,98,"Yeah..., I'm a monster."],[9,7.6,96,"There is no God in this World."],[10,7.1,98,"The witch trial shall start."],[11,7.6,98,"'Cause you are my God, Zack."],[12,8.1,98,"Try to know everything about her."],[13,8.3,105,"I'm not Your God."],[14,7.9,97,"Swear you will be killed by me."],[15,7.1,110,"A vow cannot be stolen."],[16,7.1,110,"Stop crying and smile."]]}}