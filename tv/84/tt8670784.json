{"id":"tt8670784","title":"Angels of Death","year":"2018","end":"2018","r":6.5,"v":4200,"s":{"1":[[1,7.2,155,"Kill me... please."],[2,7.0,123,"Your grave is not here."],[3,7.2,117,"I swear to God."],[4,7.3,121,"A sinner has no right of choice."],[5,7.4,115,"Don't let me kill you just yet."],[6,7.7,116,"Zack is the only one who can kill me."],[7,7.7,102,"Who are you?"],[8,8.0,95,"Yeah..., I'm a monster."],[9,7.6,93,"There is no God in this World."],[10,7.1,95,"The witch trial shall start."],[11,7.6,95,"'Cause you are my God, Zack."],[12,8.2,95,"Try to know everything about her."],[13,8.3,102,"I'm not Your God."],[14,8.0,94,"Swear you will be killed by me."],[15,8.0,107,"A vow cannot be stolen."],[16,8.0,106,"Stop crying and smile."]]}}