{"id":"tt8670784","title":"Angels of Death","year":"2018","end":"2018","r":6.5,"v":4205,"s":{"1":[[1,7.2,156,"Kill me... please."],[2,7.0,124,"Your grave is not here."],[3,7.2,118,"I swear to God."],[4,7.3,122,"A sinner has no right of choice."],[5,7.4,116,"Don't let me kill you just yet."],[6,7.7,117,"Zack is the only one who can kill me."],[7,7.7,103,"Who are you?"],[8,8.0,96,"Yeah..., I'm a monster."],[9,7.6,94,"There is no God in this World."],[10,7.2,96,"The witch trial shall start."],[11,7.6,96,"'Cause you are my God, Zack."],[12,8.2,96,"Try to know everything about her."],[13,8.3,103,"I'm not Your God."],[14,8.0,95,"Swear you will be killed by me."],[15,8.0,108,"A vow cannot be stolen."],[16,8.0,108,"Stop crying and smile."]]}}