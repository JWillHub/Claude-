{"id":"tt30217403","title":"Dandadan","year":"2024","end":"","r":8.3,"v":60448,"s":{"1":[[1,8.6,7889,"Sorette koi no hajimari jan yo"],[2,8.1,6605,"Sorette uchûjin ja ne"],[3,7.8,6226,"Babâ to babâ ga gekitotsu jan ka"],[4,8.9,7062,"Tâbo Babâ o buttobasô"],[5,8.2,5862,"Tama wa doko jan yo"],[6,8.1,5717,"Yabê onna ga kita"],[7,9.7,20909,"Yasashii sekai e"],[8,8.0,5037,"Nanka moyamoya suru jan yo"],[9,8.4,5014,"Gattai! Serupo Dôbâ Dêmon Nesshî!"],[10,7.7,4246,"Kyatoru myûtirêshon o kimi wa mita ka"],[11,7.6,4067,"Hatsukoi no hito"],[12,7.5,3939,"Noroi no ie e rettsu gô"]],"2":[[1,7.7,3582,"Orochi densetsu tte korejan yo"],[2,8.8,4133,"Jashi"],[3,8.4,3348,"Yurusa nê ze"],[4,8.9,3747,"Yabasugi jan yo"],[5,8.0,2895,"Minna de otomari jan yo"],[6,8.6,3363,"Kazoku ni narimashita"],[7,8.0,2607,"Nanka moyamoya suru jan yo"],[8,8.5,3078,"Ganbare Okarun"],[9,8.5,2671,"Ie o tatenaoshitai"],[10,7.6,2366,"Moteru hiketsu wa nanda"],[11,7.9,2199,"Kaijû jan yo"],[12,8.5,2387,"Gekitotsu! Uchû kaijû tai kyodai robo!"]],"3":[[1,null,0,"Episode #3.1"]]}}