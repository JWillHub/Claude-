{"id":"tt30217403","title":"Dandadan","year":"2024","end":"","r":8.3,"v":60614,"s":{"1":[[1,8.6,7910,"Sorette koi no hajimari jan yo"],[2,8.1,6622,"Sorette uchûjin ja ne"],[3,7.8,6243,"Babâ to babâ ga gekitotsu jan ka"],[4,8.9,7078,"Tâbo Babâ o buttobasô"],[5,8.2,5875,"Tama wa doko jan yo"],[6,8.1,5733,"Yabê onna ga kita"],[7,9.7,20950,"Yasashii sekai e"],[8,8.0,5052,"Nanka moyamoya suru jan yo"],[9,8.4,5028,"Gattai! Serupo Dôbâ Dêmon Nesshî!"],[10,7.7,4259,"Kyatoru myûtirêshon o kimi wa mita ka"],[11,7.6,4079,"Hatsukoi no hito"],[12,7.5,3952,"Noroi no ie e rettsu gô"]],"2":[[1,7.7,3593,"Orochi densetsu tte korejan yo"],[2,8.8,4147,"Jashi"],[3,8.4,3361,"Yurusa nê ze"],[4,8.9,3760,"Yabasugi jan yo"],[5,8.0,2906,"Minna de otomari jan yo"],[6,8.6,3376,"Kazoku ni narimashita"],[7,8.0,2620,"Nanka moyamoya suru jan yo"],[8,8.5,3091,"Ganbare Okarun"],[9,8.5,2685,"Ie o tatenaoshitai"],[10,7.6,2378,"Moteru hiketsu wa nanda"],[11,7.9,2211,"Kaijû jan yo"],[12,8.5,2402,"Gekitotsu! Uchû kaijû tai kyodai robo!"]],"3":[[1,null,0,"Episode #3.1"]]}}