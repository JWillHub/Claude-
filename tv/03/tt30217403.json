{"id":"tt30217403","title":"Dandadan","year":"2024","end":"","r":8.3,"v":60758,"s":{"1":[[1,8.6,7937,"Sorette koi no hajimari jan yo"],[2,8.1,6641,"Sorette uchûjin ja ne"],[3,7.8,6262,"Babâ to babâ ga gekitotsu jan ka"],[4,8.9,7100,"Tâbo Babâ o buttobasô"],[5,8.2,5895,"Tama wa doko jan yo"],[6,8.1,5754,"Yabê onna ga kita"],[7,9.7,20990,"Yasashii sekai e"],[8,8.0,5071,"Nanka moyamoya suru jan yo"],[9,8.4,5047,"Gattai! Serupo Dôbâ Dêmon Nesshî!"],[10,7.7,4278,"Kyatoru myûtirêshon o kimi wa mita ka"],[11,7.6,4098,"Hatsukoi no hito"],[12,7.5,3973,"Noroi no ie e rettsu gô"]],"2":[[1,7.7,3610,"Orochi densetsu tte korejan yo"],[2,8.8,4164,"Jashi"],[3,8.4,3377,"Yurusa nê ze"],[4,8.9,3780,"Yabasugi jan yo"],[5,8.0,2922,"Minna de otomari jan yo"],[6,8.6,3395,"Kazoku ni narimashita"],[7,8.0,2636,"Nanka moyamoya suru jan yo"],[8,8.5,3108,"Ganbare Okarun"],[9,8.5,2702,"Ie o tatenaoshitai"],[10,7.6,2392,"Moteru hiketsu wa nanda"],[11,7.9,2225,"Kaijû jan yo"],[12,8.5,2418,"Gekitotsu! Uchû kaijû tai kyodai robo!"]],"3":[[1,null,0,"Episode #3.1"]]}}