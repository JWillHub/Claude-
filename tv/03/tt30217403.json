{"id":"tt30217403","title":"Dandadan","year":"2024","end":"","r":8.3,"v":60294,"s":{"1":[[1,8.6,7876,"Sorette koi no hajimari jan yo"],[2,8.1,6595,"Sorette uchûjin ja ne"],[3,7.8,6216,"Babâ to babâ ga gekitotsu jan ka"],[4,8.9,7049,"Tâbo Babâ o buttobasô"],[5,8.2,5853,"Tama wa doko jan yo"],[6,8.1,5708,"Yabê onna ga kita"],[7,9.7,20885,"Yasashii sekai e"],[8,8.0,5027,"Nanka moyamoya suru jan yo"],[9,8.4,5006,"Gattai! Serupo Dôbâ Dêmon Nesshî!"],[10,7.7,4236,"Kyatoru myûtirêshon o kimi wa mita ka"],[11,7.6,4059,"Hatsukoi no hito"],[12,7.5,3931,"Noroi no ie e rettsu gô"]],"2":[[1,7.7,3572,"Orochi densetsu tte korejan yo"],[2,8.8,4122,"Jashi"],[3,8.4,3339,"Yurusa nê ze"],[4,8.9,3737,"Yabasugi jan yo"],[5,8.0,2887,"Minna de otomari jan yo"],[6,8.6,3356,"Kazoku ni narimashita"],[7,8.0,2601,"Nanka moyamoya suru jan yo"],[8,8.5,3071,"Ganbare Okarun"],[9,8.5,2660,"Ie o tatenaoshitai"],[10,7.6,2359,"Moteru hiketsu wa nanda"],[11,7.9,2192,"Kaijû jan yo"],[12,8.5,2377,"Gekitotsu! Uchû kaijû tai kyodai robo!"]],"3":[[1,null,0,"Episode #3.1"]]}}