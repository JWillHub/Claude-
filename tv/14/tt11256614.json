{"id":"tt11256614","title":"The Ambassador's Daughter","year":"2019","end":"2021","r":5.8,"v":3890,"s":{"1":[[1,7.4,274,"1.Bölüm"],[2,7.2,219,"Efem ala boyanmis, kaniyor her yani."],[3,6.7,196,"Adini anmayacagima Nasuh Tövbesi olsun mu?"],[4,7.3,196,"Bana memleket olmadin, kizima ol."],[5,7.5,187,"Biz o enkazin altinda kaldik."],[6,6.4,162,"Ben sana suçluyken bile inandim."],[7,7.1,174,"Arkadaslar uykularda uyansin."],[8,7.7,180,"Bana niye mektup yazmadin?"],[9,6.5,158,"Kimse sana inanmak istemez."],[10,7.4,172,"Sen mi bana kiydin, ben mi sana kiydim?"],[11,6.4,156,"Delirme, delirince geçmiyor."],[12,7.5,173,"Uzun ince bir yoldayim"],[13,6.6,149,"Ben senin katilin olmusum"],[14,7.6,166,"Kizinin elinden tut"],[15,6.4,150,"Öfkeli bir çocuga daha fazla eyvallahim yok"],[16,7.4,165,"Sen gidersen ben çok kötü bir adam olurum."],[17,6.3,158,"Bu destan denizin dibinde basladi, orada bitmez ki."]],"2":[[1,7.0,179,"Sana canimi veririm, adini vermem."],[2,7.2,163,"Senin yaninda yara mi olacak, benim yaninda yar mi?"],[3,6.2,145,"Ben ganimet degilim."],[4,6.1,140,"Bana kizim yeter."],[5,6.1,143,"Sensizlik yakiyor, onsuzluk öldürür."],[6,7.2,156,"Helalim sensin benim."],[7,7.3,157,"Senin acin, senin hakkin."],[8,6.2,141,"Destanlarda kavusamazsin ama asla ayrilmazsin."],[9,5.8,134,"Alacakus olan bendim, sen niye uçtun?"],[10,7.2,134,"Yolun sonunda sen varsin."],[11,7.9,148,"Baba omzu diye bir yer var."],[12,5.9,124,"Allah'im emri, peygamberin kavliyle..."],[13,6.9,145,"Benim memleketim yarasinda çiçek açtirir."],[14,5.5,126,"Beni yakmamayi ögrenecek misin?"],[15,7.6,149,"Pamuk oldugum günleri çok özledim"],[16,5.6,124,"Kizim bana bir kere baba desin."],[17,6.9,164,"Eyvallah Sefirin Kizi."],[18,6.3,152,"Senin için Sancar Efe"],[19,5.9,171,"Ates idim küle döndüm."],[20,7.7,219,"Gitmek mi zor kalmak mi?"],[21,7.3,228,"Mavi"],[22,7.0,184,"Sana ne oldu?"],[23,6.4,170,"Sana ihtiyacim var."],[24,6.5,165,"Ben hala anneyim."],[25,6.8,164,"Güven bana. Basaracagiz."],[26,6.8,161,"Geçmisin günahlari bugünün katilidir."],[27,6.7,160,"Kosulsuz seversen, inanirsin..."],[28,7.0,157,"Güven sevgiden bile önce gelir"],[29,6.8,160,"Gerçek sevgi her zorlugun üstesinden gelir."],[30,6.8,158,"Ask sahip olmak midir ait olmak mi?"],[31,7.4,158,"Yarim kalan her sey ardinda aci birakir"],[32,7.5,153,"Bazen sen ne kadar çabalasan da hayat izin vermez."],[33,7.4,155,"Hayat birden bire baslar, birden bire biter... Ya ask?"],[34,7.1,147,"Mutluluk kendiliginden gelmez, insa edilir..."],[35,7.0,146,"Zalim zaman... Insana hiç acimaz. Tutmaya çalissan da durmaz, geçer. Tatli aci her sey ani olur. Vakti gelen göçer gider."]]}}