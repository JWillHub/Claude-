{"id":"tt21935972","title":"Dahan: Raakan Ka Rahasya","year":"2022","end":"","r":7.1,"v":8713,"s":{"1":[[1,7.1,142,"Pramukhji Chahte Kya Hain"],[2,7.2,96,"Yahan Kabhi Barsaat Nahi Hoti"],[3,7.2,88,"Main Hi Nigal Gayi Apne Khasam Ko"],[4,6.7,82,"Pehle Shila Tooti Ya Vishwas?"],[5,7.0,81,"Chaar Ho Gayo Parimal"],[6,7.6,87,"Raakan-Raakan, Ridhiyakan"],[7,6.9,77,"Sota Mayavi Ne Jagaavegi"],[8,6.2,87,"Aur Tu Seedhe Jageyi Paatal Lok"],[9,5.6,165,"Ussko Rokna Padega, Avani!"]]}}