{"id":"tt3615002","title":"Monthly Girls' Nozaki-kun","year":"2014","end":"2014","r":7.5,"v":4977,"s":{"1":[[1,7.3,116,"Sono koi wa, shôjo manga-ka sa rete yuku."],[2,7.4,101,"Nyû hiroin o yoroshiku ne"],[3,7.5,92,"Baiorensu VS Purinsu"],[4,7.5,89,"Otoko ni wa, tatakawaneba naranai, toki ga aru."],[5,7.3,87,"Koi o \"omoi\" \"egaku\" danshi."],[6,7.7,87,"Mahô wo kakete, a-ge-ru"],[7,7.4,81,"Mangakka nô Nozaki-kun"],[8,7.8,81,"Gakuen no Ôji-Sama (joshi) no nayami"],[9,7.7,84,"Dokidoki, tari teru?"],[10,7.6,81,"Tsuyomaru no wa, kizuna to tadzuna."],[11,7.9,84,"Kome shiyo"],[12,8.3,97,"Kono kimochi ga koi janai nara, kitto sekai ni koi wanai."]],"2":[[1,7.1,33,"Special 1"],[2,7.0,32,"Special 2"],[3,6.9,31,"Special 3"],[4,7.2,31,"Special 4"],[5,7.2,31,"Special 5"],[6,7.6,31,"Special 6"]]}}