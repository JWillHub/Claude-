{"id":"tt3615002","title":"Monthly Girls' Nozaki-kun","year":"2014","end":"2014","r":7.5,"v":4986,"s":{"1":[[1,7.3,117,"Sono koi wa, shôjo manga-ka sa rete yuku."],[2,7.5,102,"Nyû hiroin o yoroshiku ne"],[3,7.5,93,"Baiorensu VS Purinsu"],[4,7.5,90,"Otoko ni wa, tatakawaneba naranai, toki ga aru."],[5,7.4,88,"Koi o \"omoi\" \"egaku\" danshi."],[6,7.7,88,"Mahô wo kakete, a-ge-ru"],[7,7.4,82,"Mangakka nô Nozaki-kun"],[8,7.8,82,"Gakuen no Ôji-Sama (joshi) no nayami"],[9,7.7,85,"Dokidoki, tari teru?"],[10,7.7,82,"Tsuyomaru no wa, kizuna to tadzuna."],[11,7.9,85,"Kome shiyo"],[12,8.4,98,"Kono kimochi ga koi janai nara, kitto sekai ni koi wanai."]],"2":[[1,7.1,34,"Special 1"],[2,7.1,33,"Special 2"],[3,6.9,32,"Special 3"],[4,7.2,32,"Special 4"],[5,7.2,32,"Special 5"],[6,7.7,32,"Special 6"]]}}