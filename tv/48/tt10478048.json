{"id":"tt10478048","title":"The Other Me","year":"2019","end":"2023","r":8.9,"v":8483,"s":{"1":[[1,8.6,338,"Ragismenos nous"],[2,8.8,289,"Otan kati fevgei, kati erhetai"],[3,8.8,293,"Sta monopatia ton mython"],[4,9.2,279,"Ta ishyra kastra peftoun apo mesa"],[5,8.9,266,"Perimenontas tous nekrous na milisoun"],[6,9.0,268,"I ishys en ti enosei"],[7,9.1,274,"O mitos tis Ariadnis"],[8,9.4,331,"I logiki tou alogou"]],"2":[[1,8.3,253,"O tritos ypopsifios"],[2,8.4,235,"Nea taxi pragmaton"],[3,8.6,234,"Kori tou Forkea"],[4,8.7,221,"Ehthros entos pylon"],[5,8.8,226,"Mia nea symmahia"],[6,8.9,235,"O vasilias apeileitai"],[7,9.2,257,"Ta tria paketa"],[8,9.7,498,"Mia aforiti niki"]],"3":[[1,7.8,193,"I arhi tou telous"],[2,7.6,176,"I epistrofi tou asotou"],[3,7.8,159,"To parelthon epistrefei"],[4,7.8,161,"I athanasia ton oneiron"],[5,8.2,154,"I kravgi ton nekron"],[6,8.1,160,"Ydor tholeron kai apaidefton psyhin ou dei tarattein"],[7,8.6,168,"Ithos anthropo daimon"],[8,7.8,228,"Pyr makhaira mi skalevein: Pythagoras"]]}}