{"id":"tt1773185","title":"Puella Magi Madoka Magica","year":"2011","end":"2011","r":8.2,"v":15127,"s":{"1":[[1,7.4,923,"Yume no naka de atta, yôna..."],[2,7.4,853,"Sore wa tottemo ureshi inatte"],[3,8.3,944,"Mou nani mo kowakunai"],[4,8.0,820,"Kiseki mo, mahô mo, arundayo"],[5,7.7,799,"Koukai nante, Aru Wake Nai"],[6,8.2,810,"Konna no Zettai Okashiiyo"],[7,8.4,827,"Honto no Kimochi to Mukiaemasu ka?"],[8,9.0,919,"Atashitte, honto baka"],[9,8.7,832,"Sonna no, Atashi ga Yurusanai"],[10,9.5,1257,"Mo dare ni mo tayoranai"],[11,9.1,878,"Saigo ni Nokotta Michishirube"],[12,9.2,994,"Watashi no saikou no tomodachi"]]}}