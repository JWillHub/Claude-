{"id":"tt1773185","title":"Puella Magi Madoka Magica","year":"2011","end":"2011","r":8.2,"v":15222,"s":{"1":[[1,7.4,939,"Yume no naka de atta, yôna..."],[2,7.4,869,"Sore wa tottemo ureshi inatte"],[3,8.3,961,"Mou nani mo kowakunai"],[4,8.0,834,"Kiseki mo, mahô mo, arundayo"],[5,7.7,813,"Koukai nante, Aru Wake Nai"],[6,8.2,824,"Konna no Zettai Okashiiyo"],[7,8.4,843,"Honto no Kimochi to Mukiaemasu ka?"],[8,9.0,934,"Atashitte, honto baka"],[9,8.7,849,"Sonna no, Atashi ga Yurusanai"],[10,9.5,1277,"Mo dare ni mo tayoranai"],[11,9.1,895,"Saigo ni Nokotta Michishirube"],[12,9.2,1013,"Watashi no saikou no tomodachi"]]}}