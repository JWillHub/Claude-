{"id":"tt1773185","title":"Puella Magi Madoka Magica","year":"2011","end":"2011","r":8.2,"v":15103,"s":{"1":[[1,7.4,910,"Yume no naka de atta, yôna..."],[2,7.4,844,"Sore wa tottemo ureshi inatte"],[3,8.3,934,"Mou nani mo kowakunai"],[4,8.0,812,"Kiseki mo, mahô mo, arundayo"],[5,7.7,789,"Koukai nante, Aru Wake Nai"],[6,8.2,799,"Konna no Zettai Okashiiyo"],[7,8.4,816,"Honto no Kimochi to Mukiaemasu ka?"],[8,9.0,906,"Atashitte, honto baka"],[9,8.7,822,"Sonna no, Atashi ga Yurusanai"],[10,9.5,1244,"Mo dare ni mo tayoranai"],[11,9.1,869,"Saigo ni Nokotta Michishirube"],[12,9.2,985,"Watashi no saikou no tomodachi"]]}}