{"id":"tt33246682","title":"A Night's Tale","year":"2024","end":"2025","r":5.8,"v":1801,"s":{"1":[[1,6.4,256,"Gelin ata binmis ya nasip demis"],[2,6.8,232,"Ervah-i Ezelden"],[3,6.5,214,"Aradigin seni arayandir"],[4,7.5,193,"Nemrud'un Kizi"],[5,7.8,183,"Demek Sen Galata. Ben de Kiz Kulesi. Memnun oldum tanistigimiza"],[6,7.1,163,"Gidisim de elvedasiz olsun istedim"],[7,7.7,172,"Su Perisi ve Sakayik"],[8,8.3,112,"Su akar yolunu bulur"],[9,8.3,105,"Yalanci Bahar"],[10,8.2,107,"Sen ol da, ister yar ol, ister yara"],[11,8.2,107,"Her nasip vaktine esirdir"],[12,8.3,110,"Yolun açik olsun Galata, Kiz Kulesi tek basina da yakisir bu masala"],[13,8.3,94,"Ayaginda diken yarasi olmayan sinesine gül kokusu süremez"],[14,8.3,97,"Buz ve Ates"],[15,8.2,88,"küçük Hanim"],[16,8.4,94,"Sen Benim Sehrazad'imsin..."],[17,8.4,95,"Yeni bir yil..."],[18,8.3,91,"Ask Adam"],[19,7.7,64,"Ask ve Süphe"],[20,7.8,62,"Mola"],[21,7.8,59,"Elizabeth"],[22,7.4,48,"Ruhlarin Bulusmasi"],[23,7.4,47,"Kalbimizde Tasidiklarimiz"],[24,7.3,48,"Kimi çok seversen o senin imtihanindir"],[25,7.4,44,"Ruhumun Gökyüzü"],[26,7.1,44,"Ateskes"],[27,6.8,46,"Erkek Güzeli"],[28,7.0,48,"Askta Ve Savasta"],[29,7.4,45,"Urfali Ve Sehrazat"],[30,7.2,42,"Yildizlarin Altinda"],[31,7.3,40,"Kirmizi Bisiklet"],[32,6.8,35,"Basli basina bir siir"],[33,6.8,34,"Bu Dünya Üçümüzün..."],[34,6.7,33,"Uçurum"],[35,6.8,32,"Nilufer: Final"]]}}