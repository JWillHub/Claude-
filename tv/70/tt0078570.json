{"id":"tt0078570","title":"Lady Oscar: The Rose of Versailles","year":"1979","end":"1980","r":8.3,"v":2897,"s":{"1":[[1,7.9,104,"Osukaru! Bara no sadame"],[2,7.5,84,"Mae! Ôsutoria no chou"],[3,7.2,81,"Berusaiyu ni hibana chiru"],[4,7.6,72,"Bara to sake to takurami to..."],[5,7.4,71,"Koukisa wo namida ni komete..."],[6,7.3,65,"Kinu no doresu to borofuku"],[7,7.6,65,"Ai no tegami wa dare no te de"],[8,7.9,67,"Waga kokoro no Osukaru"],[9,8.0,67,"Hi wa suzumi hi wa noboru"],[10,7.8,64,"Utsukushii akuma Jannu"],[11,7.7,60,"Fersen kitaguni he saru"],[12,7.6,59,"Kettou no asa Osukaru wa...?"],[13,7.9,63,"Arasu no kaze yo kotaete..."],[14,7.7,60,"Tenshi no himitsu"],[15,7.5,58,"Kajino no hakushaku fujin"],[16,7.6,58,"Haha, sono hito no na wa...?"],[17,7.7,58,"Ima meguriai no toki"],[18,7.4,55,"Totsuzen Ikarusu no you ni"],[19,8.4,67,"Sayonara imouto yo!"],[20,8.1,61,"Feruzen nagori no rinbu"],[21,7.5,58,"Kurobara wa yoru hiraku"],[22,7.8,55,"Kubikazari wa fukitsu na kagayaki"],[23,8.3,60,"Zuru kashikute takumashiku!"],[24,8.2,61,"Aduu, watashi no seishun"],[25,8.3,64,"Katakoi no menuetto"],[26,7.5,55,"Kuroi kishi ni aitai!"],[27,8.2,59,"Tatoe hikari wo ushinau tomo..."],[28,8.6,62,"Andore, aoi remon"],[29,8.5,58,"Aruki hajimeta ningyou"],[30,8.1,52,"Omae wa hikari ore wa kage"],[31,8.3,53,"Heiei ni saku rira no hana"],[32,8.4,60,"Arashi no pureryûdo"],[33,8.0,50,"Tasogare ni choushou wa naru"],[34,8.3,53,"Ima, 'Tenisu kôto no chikai'"],[35,8.1,57,"Osukaru, ima, subanare no toki"],[36,8.4,54,"Aikotoba wa 'Sayonara'"],[37,8.7,63,"Atsuki chikai no yoru ni"],[38,8.5,59,"Unmei no tobira no mae de"],[39,8.7,85,"Ano bishou wa mou kaeranai!"],[40,8.7,82,"Sayounara waga itoshi no Osukaru"],[41,8.6,33,"Berusaiyu no bara to onnatachi"]]}}