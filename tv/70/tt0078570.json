{"id":"tt0078570","title":"Lady Oscar: The Rose of Versailles","year":"1979","end":"1980","r":8.3,"v":2903,"s":{"1":[[1,7.9,106,"Osukaru! Bara no sadame"],[2,7.5,86,"Mae! Ôsutoria no chou"],[3,7.2,83,"Berusaiyu ni hibana chiru"],[4,7.7,74,"Bara to sake to takurami to..."],[5,7.4,73,"Koukisa wo namida ni komete..."],[6,7.4,67,"Kinu no doresu to borofuku"],[7,7.7,67,"Ai no tegami wa dare no te de"],[8,7.9,69,"Waga kokoro no Osukaru"],[9,8.1,69,"Hi wa suzumi hi wa noboru"],[10,7.9,66,"Utsukushii akuma Jannu"],[11,7.8,62,"Fersen kitaguni he saru"],[12,7.7,61,"Kettou no asa Osukaru wa...?"],[13,7.9,65,"Arasu no kaze yo kotaete..."],[14,7.7,61,"Tenshi no himitsu"],[15,7.6,59,"Kajino no hakushaku fujin"],[16,7.6,59,"Haha, sono hito no na wa...?"],[17,7.7,59,"Ima meguriai no toki"],[18,7.4,56,"Totsuzen Ikarusu no you ni"],[19,8.5,68,"Sayonara imouto yo!"],[20,8.1,62,"Feruzen nagori no rinbu"],[21,7.6,59,"Kurobara wa yoru hiraku"],[22,7.8,56,"Kubikazari wa fukitsu na kagayaki"],[23,8.3,61,"Zuru kashikute takumashiku!"],[24,8.2,62,"Aduu, watashi no seishun"],[25,8.4,65,"Katakoi no menuetto"],[26,7.6,56,"Kuroi kishi ni aitai!"],[27,8.2,60,"Tatoe hikari wo ushinau tomo..."],[28,8.7,63,"Andore, aoi remon"],[29,8.5,59,"Aruki hajimeta ningyou"],[30,8.2,53,"Omae wa hikari ore wa kage"],[31,8.3,54,"Heiei ni saku rira no hana"],[32,8.4,61,"Arashi no pureryûdo"],[33,8.0,51,"Tasogare ni choushou wa naru"],[34,8.4,54,"Ima, 'Tenisu kôto no chikai'"],[35,8.2,58,"Osukaru, ima, subanare no toki"],[36,8.4,55,"Aikotoba wa 'Sayonara'"],[37,8.7,64,"Atsuki chikai no yoru ni"],[38,8.6,60,"Unmei no tobira no mae de"],[39,8.7,86,"Ano bishou wa mou kaeranai!"],[40,8.7,83,"Sayounara waga itoshi no Osukaru"],[41,8.6,33,"Berusaiyu no bara to onnatachi"]]}}