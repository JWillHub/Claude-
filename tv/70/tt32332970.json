{"id":"tt32332970","title":"My Deer Friend Nokotan","year":"2024","end":"2024","r":6.7,"v":2192,"s":{"1":[[1,7.4,353,"Gâru mîtsu shika"],[2,7.4,280,"Shika mîtsu kura gâru"],[3,7.1,236,"Bashame nyûgaku"],[4,7.1,201,"Nerawareta shika-bu"],[5,7.4,198,"Aitsu no yowami o nigire!!"],[6,6.9,184,"Natsu no shika matsuri"],[7,7.0,173,"Shikakore toka haishin toka omotenashi toka"],[8,7.3,174,"Yuku shika, kuru shika"],[9,7.0,151,"Taiikumatsuri o yaritogero"],[10,6.8,156,"Zenbu, haru no sei"],[11,7.3,150,"The Pursuer and the Pursued."],[12,6.7,151,"Saraba Nokotan!? Shika-bu yo eien ni"]]}}