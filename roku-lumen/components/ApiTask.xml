<?xml version="1.0" encoding="utf-8" ?>
<!-- Network work (Real-Debrid, TMDB) runs here, off the UI thread. Set request, then control = "RUN"; the answer lands in result. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" />
    <field id="result" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
