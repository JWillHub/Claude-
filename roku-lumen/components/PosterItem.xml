<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="focusPercent" type="float" onChange="focus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
  <children>
    <Rectangle id="bg" width="240" height="360" color="0x1A1A1AFF" />
    <Label id="alt" width="220" height="340" translation="[10,10]" wrap="true" horizAlign="center" vertAlign="center" color="0xBBBBBBFF" font="font:SmallSystemFont" />
    <Poster id="img" width="240" height="360" loadDisplayMode="scaleToZoom" />
    <Rectangle id="barbg" translation="[10,342]" width="220" height="6" color="0x00000099" visible="false" />
    <Rectangle id="bar" translation="[10,342]" width="0" height="6" color="0xFFFFFFFF" visible="false" />
    <Label id="name" translation="[0,372]" width="240" height="40" color="0x9A9A9AFF" font="font:SmallestSystemFont" />
  </children>
</component>
